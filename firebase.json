{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".agents/**",
      "**/scratch/**",
      "node_modules/**",
      "scripts/**",
      "backups/**",
      "*.zip",
      "**/*.zip",
      "*.py",
      "*.txt",
      "*.js",
      "package*.json",
      "**/*.xlsx",
      "*.xlsx"
    ],
    "headers": [
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/dashboard12_troskova.html"
      }
    ]
  }
}
