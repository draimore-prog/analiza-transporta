{
  "expo": {
    "name": "Bingo Servis Mehanizacije",
    "slug": "bingo-servis-mehanizacije",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ba.bingo.servismehanizacije",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacija pristupa fotografijama radi dokumentovanja servisa.",
          "cameraPermission": "Aplikacija pristupa kameri radi slikanja oštećenja i radnih naloga."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f46e5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aba5c8a2-9d9f-4ec6-8060-442bc8068155"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aba5c8a2-9d9f-4ec6-8060-442bc8068155"
    },
    "ios": {}
  }
}
