rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Dozvoli javno čitanje svih slika vozila, računa i priloga
      allow read: if true;
      
      // Dozvoli upload slika i PDF dokumenata do 20MB
      allow write: if request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
